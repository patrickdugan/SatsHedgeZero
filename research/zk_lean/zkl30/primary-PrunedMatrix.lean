    wellFormed_withRows (withRows H ((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224)) _ hs4 (erase_subset ((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224) 4221)
  have e6 : accepts (withRows H (((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224).eraseIdx 4221)) x ↔ accepts (withRows H ((((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224).eraseIdx 4221).eraseIdx 4219)) x := by
    apply dead_output_delete (withRows H (((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224).eraseIdx 4221)) 4219 dead6 1 1 row6 hs5 _ x
    unfold deadOutputCheck
    apply decide_eq_true
    refine ⟨by decide, ?_, ?_, ht6, by decide, by decide, by decide, ?_, hoth6⟩
    · change dead6 ∉ H.publicWires
