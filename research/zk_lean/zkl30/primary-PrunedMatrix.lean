    (ht1 : g0[5444]? = some row1)
    (hpos1 : ∀ q ∈ refs1, q.1 ≠ 5444 ∧ g0[q.1]? = some q.2)
    (hi2 : 5441 < (g0.eraseIdx 5444).length)
    (ht2 : (g0.eraseIdx 5444)[5441]? = some row2)
    (hpos2 : ∀ q ∈ refs2, q.1 ≠ 5441 ∧ (g0.eraseIdx 5444)[q.1]? = some q.2)
    (ht3 : ((g0.eraseIdx 5444).eraseIdx 5441)[5439]? = some row3)
    (hoth3 : ∀ r ∈ ((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439, ∀ t ∈ r.a ++ r.b ++ r.c, t.wire ≠ dead3)
    (hi4 : 4224 < (((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).length)
    (ht4 : (((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439)[4224]? = some row4)
    (hpos4 : ∀ q ∈ refs4, q.1 ≠ 4224 ∧ (((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439)[q.1]? = some q.2)
    (hi5 : 4221 < ((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224).length)
    (ht5 : ((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224)[4221]? = some row5)
    (hpos5 : ∀ q ∈ refs5, q.1 ≠ 4221 ∧ ((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224)[q.1]? = some q.2)
    (ht6 : (((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224).eraseIdx 4221)[4219]? = some row6)
    (hoth6 : ∀ r ∈ (((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224).eraseIdx 4221).eraseIdx 4219, ∀ t ∈ r.a ++ r.b ++ r.c, t.wire ≠ dead6)
    (x : List Nat) :
    accepts (withRows H g0) x ↔ accepts (withRows H ((((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224).eraseIdx 4221).eraseIdx 4219)) x := by
  have e1 := checked_indexed_poly_delete (withRows H g0) 5444 row1 refs1
    weights1 correction1 hs0 hi1 ht1 hpos1 (by decide)
    (by change polyCheck H.modulus row1 weights1 correction1 = true; decide) x
  have hs1 : wellFormed (withRows H (g0.eraseIdx 5444)) :=
    wellFormed_withRows (withRows H g0) _ hs0 (erase_subset g0 5444)
  have e2 := checked_indexed_poly_delete (withRows H (g0.eraseIdx 5444)) 5441 row2 refs2
    weights2 correction2 hs1 hi2 ht2 hpos2 (by decide)
    (by change polyCheck H.modulus row2 weights2 correction2 = true; decide) x
  have hs2 : wellFormed (withRows H ((g0.eraseIdx 5444).eraseIdx 5441)) :=
    wellFormed_withRows (withRows H (g0.eraseIdx 5444)) _ hs1 (erase_subset (g0.eraseIdx 5444) 5441)
  have e3 : accepts (withRows H ((g0.eraseIdx 5444).eraseIdx 5441)) x ↔ accepts (withRows H (((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439)) x := by
    apply dead_output_delete (withRows H ((g0.eraseIdx 5444).eraseIdx 5441)) 5439 dead3 1 1 row3 hs2 _ x
    unfold deadOutputCheck
    apply decide_eq_true
    refine ⟨by decide, ?_, ?_, ht3, by decide, by decide, by decide, ?_, hoth3⟩
    · change dead3 ∉ H.publicWires
      decide
    · change dead3 < H.wires
      decide
    · change (1 * 1) % H.modulus = 1
      decide
  have hs3 : wellFormed (withRows H (((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439)) :=
    wellFormed_withRows (withRows H ((g0.eraseIdx 5444).eraseIdx 5441)) _ hs2 (erase_subset ((g0.eraseIdx 5444).eraseIdx 5441) 5439)
  have e4 := checked_indexed_poly_delete (withRows H (((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439)) 4224 row4 refs4
    weights4 correction4 hs3 hi4 ht4 hpos4 (by decide)
    (by change polyCheck H.modulus row4 weights4 correction4 = true; decide) x
  have hs4 : wellFormed (withRows H ((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224)) :=
    wellFormed_withRows (withRows H (((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439)) _ hs3 (erase_subset (((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439) 4224)
  have e5 := checked_indexed_poly_delete (withRows H ((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224)) 4221 row5 refs5
