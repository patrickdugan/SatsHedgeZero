  have hs6 : wellFormed (withRows H ((((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224).eraseIdx 4221).eraseIdx 4219)) :=
    wellFormed_withRows (withRows H (((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224).eraseIdx 4221)) _ hs5 (erase_subset (((((g0.eraseIdx 5444).eraseIdx 5441).eraseIdx 5439).eraseIdx 4224).eraseIdx 4221) 4219)
  exact (e1.trans (e2.trans (e3.trans (e4.trans (e5.trans e6)))))

