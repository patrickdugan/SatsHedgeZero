  have e6 : accepts (withRows H (((((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204).eraseIdx 3989).eraseIdx 3986)) x ↔ accepts (withRows H ((((((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204).eraseIdx 3989).eraseIdx 3986).eraseIdx 3984)) x := by
    apply dead_output_delete (withRows H (((((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204).eraseIdx 3989).eraseIdx 3986)) 3984 dead6 1 1 row6 hs5 _ x
