    wellFormed_withRows (withRows H (((((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204).eraseIdx 3989).eraseIdx 3986)) _ hs5 (erase_subset (((((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204).eraseIdx 3989).eraseIdx 3986) 3984)
  exact (e1.trans (e2.trans (e3.trans (e4.trans (e5.trans e6)))))

