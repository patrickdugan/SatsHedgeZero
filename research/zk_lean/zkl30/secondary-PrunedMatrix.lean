  have e3 : accepts (withRows H ((g0.eraseIdx 5209).eraseIdx 5206)) x ↔ accepts (withRows H (((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204)) x := by
    apply dead_output_delete (withRows H ((g0.eraseIdx 5209).eraseIdx 5206)) 5204 dead3 1 1 row3 hs2 _ x
    unfold deadOutputCheck
    apply decide_eq_true
    refine ⟨by decide, ?_, ?_, ht3, by decide, by decide, by decide, ?_, hoth3⟩
    · change dead3 ∉ H.publicWires
      decide
    · change dead3 < H.wires
      decide
    · change (1 * 1) % H.modulus = 1
      decide
  have hs3 : wellFormed (withRows H (((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204)) :=
    wellFormed_withRows (withRows H ((g0.eraseIdx 5209).eraseIdx 5206)) _ hs2 (erase_subset ((g0.eraseIdx 5209).eraseIdx 5206) 5204)
  have e4 := checked_indexed_poly_delete (withRows H (((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204)) 3989 row4 refs4
