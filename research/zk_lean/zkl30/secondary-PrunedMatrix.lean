    (ht4 : (((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204)[3989]? = some row4)
    (hpos4 : ∀ q ∈ refs4, q.1 ≠ 3989 ∧ (((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204)[q.1]? = some q.2)
    (hi5 : 3986 < ((((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204).eraseIdx 3989).length)
    (ht5 : ((((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204).eraseIdx 3989)[3986]? = some row5)
    (hpos5 : ∀ q ∈ refs5, q.1 ≠ 3986 ∧ ((((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204).eraseIdx 3989)[q.1]? = some q.2)
    (ht6 : (((((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204).eraseIdx 3989).eraseIdx 3986)[3984]? = some row6)
    (hoth6 : ∀ r ∈ (((((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204).eraseIdx 3989).eraseIdx 3986).eraseIdx 3984, ∀ t ∈ r.a ++ r.b ++ r.c, t.wire ≠ dead6)
    (x : List Nat) :
    accepts (withRows H g0) x ↔ accepts (withRows H ((((((g0.eraseIdx 5209).eraseIdx 5206).eraseIdx 5204).eraseIdx 3989).eraseIdx 3986).eraseIdx 3984)) x := by
  have e1 := checked_indexed_poly_delete (withRows H g0) 5209 row1 refs1
    weights1 correction1 hs0 hi1 ht1 hpos1 (by decide)
    (by change polyCheck H.modulus row1 weights1 correction1 = true; decide) x
  have hs1 : wellFormed (withRows H (g0.eraseIdx 5209)) :=
    wellFormed_withRows (withRows H g0) _ hs0 (erase_subset g0 5209)
  have e2 := checked_indexed_poly_delete (withRows H (g0.eraseIdx 5209)) 5206 row2 refs2
    weights2 correction2 hs1 hi2 ht2 hpos2 (by decide)
