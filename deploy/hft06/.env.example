# HFT-06 relay/collator environment. Copy to deploy/hft06/.env (gitignored).
# Never commit real values. Prefer a secret manager mount and the *_FILE form.

# Trusted-relay signing key: 32-byte hex BIP340 secret, or a file containing it.
# Generate with: shz-relay keygen --out deploy/hft06/secrets/relay.key
SHZ_RELAY_SIGNING_KEY=
SHZ_RELAY_SIGNING_KEY_FILE=/run/secrets/relay.key

# Development only: run the five fixture federation signers in-process.
SHZ_DEV_FEDERATION=0

# Live provider credentials (only with the `live` feature and a live source).
# Pyth Pro / Lazer access token (requires a Pyth Pro subscription and
# redistribution terms covering the relay's downstream tiers).
PYTH_LAZER_ACCESS_TOKEN=
# Chainlink Data Streams API client ID and HMAC secret.
CHAINLINK_DS_CLIENT_ID=
CHAINLINK_DS_CLIENT_SECRET=
